{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "publicURL": {
      "type": "string",
      "minLength": 1
    },
    "allowInsecureCookies": {
      "type": "boolean"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicURL": {
          "type": "string",
          "minLength": 1
        },
        "externalURL": {
          "type": "string"
        },
        "workflowDirs": {
          "type": "string",
          "enum": [
            ".forgejo/workflows",
            ".github/workflows",
            ".forgejo/workflows,.github/workflows",
            ".github/workflows,.forgejo/workflows"
          ]
        },
        "qualifiedVersion": {
          "type": "string",
          "enum": [
            "15.0.9"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ]
        },
        "sshPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9.-]+:[0-9]{1,5}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "sslMode": {
              "type": "string",
              "enum": [
                "disable",
                "require",
                "verify-ca",
                "verify-full"
              ]
            }
          },
          "required": [
            "host",
            "name",
            "user",
            "sslMode"
          ]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "dataSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "configSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            }
          },
          "required": [
            "storageClass",
            "dataSize",
            "configSize"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        }
      },
      "required": [
        "enabled",
        "publicURL",
        "externalURL",
        "qualifiedVersion",
        "image",
        "sshPort",
        "database",
        "persistence",
        "resources"
      ]
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            }
          },
          "required": [
            "storageClass",
            "size"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "existingCASecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      },
      "required": [
        "enabled",
        "image",
        "persistence",
        "resources"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tlsSecret": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "tlsSecret"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "podSelector": {
                "type": "object"
              },
              "namespaceSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            }
          }
        },
        "forgejoIngressFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "podSelector": {
                "type": "object"
              },
              "namespaceSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            }
          }
        },
        "postgresIngressFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "podSelector": {
                "type": "object"
              },
              "namespaceSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            }
          }
        },
        "externalEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "podSelector": {
                      "type": "object"
                    },
                    "namespaceSelector": {
                      "type": "object"
                    },
                    "ipBlock": {
                      "type": "object"
                    }
                  }
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "to",
              "ports"
            ]
          }
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dnsPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "podSelector": {
                "type": "object"
              },
              "namespaceSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "cidr"
                ]
              }
            }
          }
        }
      },
      "required": [
        "enabled",
        "ingressFrom",
        "forgejoIngressFrom",
        "postgresIngressFrom",
        "externalEgress",
        "dnsNamespace"
      ]
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingressFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "enabled",
            "ingressFrom"
          ]
        },
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "insecure": {
              "type": "boolean"
            },
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "endpoint",
            "insecure",
            "sampleRatio"
          ]
        }
      },
      "required": [
        "metrics",
        "tracing"
      ]
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpsEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "enabled",
        "httpsEgress"
      ]
    },
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "forgejo"
          ]
        },
        "instanceID": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "kind",
        "instanceID"
      ]
    },
    "disruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "image",
    "imagePullSecrets",
    "replicaCount",
    "publicURL",
    "allowInsecureCookies",
    "existingSecret",
    "oauth",
    "resources",
    "forgejo",
    "postgresql",
    "ingress",
    "networkPolicy",
    "webhooks"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}

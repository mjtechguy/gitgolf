      "datasource": {
        "type": "prometheus",
        "uid": "golf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(golf_telemetry_trace_exports_total[1m]))",
          "legendFormat": "__auto",
          "range": true

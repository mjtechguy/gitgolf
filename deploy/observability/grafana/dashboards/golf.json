      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "What this dashboard measures",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "mode": "markdown",
        "content": "Golf HTTP, Forgejo client calls and PostgreSQL queries. Use Explore \u2192 Golf Jaeger for sampled request traces; correlate opaque trace/request IDs with Golf JSON logs. Missing series mean no matching observations, not zero failures. Jaeger keeps at most 5,000 traces in memory; Prometheus retains at most 24 hours / 256 MB. No job, runner, SLO, provider-internal or production monitoring is claimed."
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}

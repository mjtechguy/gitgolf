{
  "name": "golf-binding-qualification",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "REPLACE_WITH_APPROVED_NAMESPACE" }],
